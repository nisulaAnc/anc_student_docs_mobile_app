{
  "expo": {
    "name": "DMS",
    "slug": "anc-student-docs",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/Docs logo.png",
    "splash": {
      "image": "./assets/Docs logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A8A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ancedu.studentdocs",
      "infoPlist": {
        "NSCameraUsageDescription": "Required to scan QR codes and capture documents.",
        "NSPhotoLibraryUsageDescription": "Required to upload documents from your photo library."
      }
    },
    "android": {
      "package": "com.ancedu.studentdocs",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "2e019adf-76e1-4891-9b06-502335b06350"
      }
    }
  }
}
